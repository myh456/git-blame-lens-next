{
  "name": "git-blame-lens",
  "displayName": "Git Blame Lens",
  "description": "🎯 优雅的Git Blame可视化工具 | 显示代码行作者信息和提交历史 | 支持悬停详情和智能缓存",
  "version": "0.0.4",
  "publisher": "dreamecho",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamechoc/git-blame-lens.git"
  },
  "bugs": {
    "url": "https://github.com/dreamechoc/git-blame-lens/issues"
  },
  "homepage": "https://github.com/dreamechoc/git-blame-lens#readme",
  "keywords": [
    "git",
    "blame",
    "author",
    "commit",
    "history",
    "lens",
    "annotation",
    "vcs",
    "source control",
    "code review",
    "git log",
    "developer tools"
  ],
  "categories": [
    "SCM Providers"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-author.showFullCommit",
        "title": "查看文件差异",
        "icon": "$(diff)"
      },
      {
        "command": "git-author.showBlameAnnotations",
        "title": "显示 Blame 注释",
        "icon": "$(eye)"
      },
      {
        "command": "git-author.hideBlameAnnotations",
        "title": "隐藏 Blame 注释",
        "icon": "$(eye-closed)"
      },
      {
        "command": "git-author.refreshBlameAnnotations",
        "title": "刷新 Blame 注释",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "git-author.showBlameAnnotations",
          "group": "git-blame@1",
          "when": "editorTextFocus && !git-author.blameActive"
        },
        {
          "command": "git-author.hideBlameAnnotations",
          "group": "git-blame@1",
          "when": "editorTextFocus && git-author.blameActive"
        },
        {
          "command": "git-author.refreshBlameAnnotations",
          "group": "git-blame@2",
          "when": "editorTextFocus && git-author.blameActive"
        }
      ]
    },
    "configuration": {
      "title": "Git Blame Lens",
      "properties": {
        "gitBlameLens.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示当前行的Git作者信息"
        },
        "gitBlameLens.showOnHover": {
          "type": "boolean",
          "default": true,
          "description": "鼠标悬停时显示详细的提交信息"
        },
        "gitBlameLens.enableBlameAnnotations": {
          "type": "boolean",
          "default": false,
          "description": "启动时自动显示Git blame注释"
        },
        "gitBlameLens.recentCommitThreshold": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 30,
          "description": "最近提交的天数阈值（用星号标记）"
        },
        "gitBlameLens.blameAnnotationWidth": {
          "type": "string",
          "default": "15em",
          "description": "Blame注释区域的宽度"
        },
        "gitBlameLens.preloadLines": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 100,
          "description": "可见区域上下预加载的行数"
        },
        "gitBlameLens.scrollDebounceMs": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "maximum": 200,
          "description": "滚动防抖延迟时间（毫秒）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish",
    "generate-icon": "node generate-icon.js",
    "choose-icon": "node choose-icon.js",
    "setup": "node quick-setup.js",
    "dist" : "npx vsce package"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@vscode/vsce": "^3.6.0",
    "canvas": "^3.1.1"
  }
}
